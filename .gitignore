# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# pubspec.lock 自 2026-10-06（v0.2.26-beta）起【入库跟踪】：
# 依赖解析固定下来，构建可复现（此前每次 CI 重新求解，Flutter stable
# 或依赖发新版都可能让"上次能过的构建"突然失败且无法二分）。
# lock 升级只能显式发生；CI 会在 pub get 后发现 lock 漂移时自动
# 回提交到当前分支（见 build.yml「Track pubspec.lock」步骤）。

# IDE
.idea/
.vscode/
*.iml

# Platform dirs are generated in CI by `flutter create .`
android/
ios/

# Drift codegen output is generated in CI by `dart run build_runner build`
lib/services/database.g.dart

# Misc
*.log
.DS_Store

# Python：CI 里用 python 做 gradle 文本校验，会留下 __pycache__
__pycache__/
*.pyc

# proot 运行库的**真实二进制**不入库（几 MB 且平台相关），
# 由 CI 从 Termux 源下载后注入 android/app/src/main/assets/。
# 仓库里只保留占位文件，让本地 flutter test/analyze 不因 asset 缺失而失败。
