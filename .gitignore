# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# 依赖在 CI 中统一 pub get 解析；不跟踪 lock，避免本地/CI 版本不一致导致求解冲突
pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# Platform dirs are generated in CI by `flutter create .`
android/
ios/

# Drift codegen output is generated in CI by `dart run build_runner build`
lib/services/database.g.dart

# Misc
*.log
.DS_Store

# Python：CI 里用 python 做 gradle 文本校验，会留下 __pycache__
__pycache__/
*.pyc
